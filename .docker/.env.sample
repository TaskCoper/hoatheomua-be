# =============================================================================
# HoaTheoMua Backend API - Local Development Environment
# Copy to `.env` (same folder) and fill in real values.
# =============================================================================

# Environment Configuration (maps to Environment / ASPNETCORE_ENVIRONMENT)
ENVIRONMENT=Development

# HTTP Configuration (host port published for the API container; also maps to HttpPort)
HTTP_PORT=8080

# PostgreSQL Configuration
POSTGRES_DBNAME=hoatheomua
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=POSTGRES_PASSWORD
# Host port published for Postgres. Used by compose.yaml (dev defaults 5432, prod 5433 if unset) and docker-compose.yml.
POSTGRES_PORT=5432
POSTGRES_MAX_IDLE_CONNS=2
POSTGRES_MAX_OPEN_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=30

# JWT Configuration (validation only — taskcoper-be issues tokens, this service only validates).
# These three MUST be identical to taskcoper-be's JWT_ISSUER / JWT_AUDIENCE / JWT_ACCESS_TOKEN_KEY.
JWT_ISSUER=JWT_ISSUER
JWT_AUDIENCE=JWT_AUDIENCE
JWT_ACCESS_TOKEN_KEY=JWT_ACCESS_TOKEN_KEY

# Ahamove Shipping Configuration (maps to AhamoveOption)
AHAMOVE_TOKEN=AHAMOVE_TOKEN
AHAMOVE_BASE_URL=AHAMOVE_BASE_URL

# NhanhVn Configuration (maps to NhanhVnOption)
NHANHVN_TOKEN=NHANHVN_TOKEN
NHANHVN_APP_ID=NHANHVN_APP_ID
NHANHVN_BUSINESS_ID=NHANHVN_BUSINESS_ID
NHANHVN_BASE_URL=NHANHVN_BASE_URL

# BaoKim Configuration (maps to BaoKimOption).
# Both keys are PEM blocks on ONE line; the \n escapes expand to real newlines.
# For a real secret you can also skip this file and run:
#   gh secret set BAOKIM_PRIVATE_KEY --env <env> < private.pem
# PRIVATE_KEY is ours and signs outbound calls. PUBLIC_KEY is BaoKim's own key, taken from the
# merchant dashboard, and verifies the Signature header on inbound webhooks — without it the
# /api/v1/baokim callback fails closed rather than fulfilling orders on unverified input.
BAOKIM_BASE_URL=BAOKIM_BASE_URL
BAOKIM_MERCHANT_CODE=BAOKIM_MERCHANT_CODE
BAOKIM_CLIENT_ID=BAOKIM_CLIENT_ID
BAOKIM_CLIENT_SECRET=BAOKIM_CLIENT_SECRET
BAOKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
BAOKIM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Sepay Configuration (maps to SepayOption). SePay sends "Authorization: Apikey <ApiKey>" on every
# webhook call; without this set the /api/v1/sepay callback fails closed rather than fulfilling
# orders on unverified input.
SEPAY_API_KEY=SEPAY_API_KEY

# Cloudflare Tunnel (public ingress for the API)
CLOUDFLARE_TUNNEL_TOKEN=

# Docker Registry Configuration (for compose.yaml)
REGISTRY=localhost/hoatheomua
TAG=local
