# =============================================================================
# HoaTheoMua Backend API - Local Development Environment
# Copy to `.env` (same folder) and fill in real values.
# =============================================================================

# Environment Configuration (maps to Environment / ASPNETCORE_ENVIRONMENT)
ENVIRONMENT=Development

# HTTP Configuration (host port published for the API container; also maps to HttpPort)
HTTP_PORT=8080

# PostgreSQL Configuration
POSTGRES_DBNAME=hoatheomua
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=POSTGRES_PASSWORD
# Host port published by docker-compose.yml (the profile-based compose.yaml hardcodes 5432/5433)
POSTGRES_PORT=5432
POSTGRES_MAX_IDLE_CONNS=2
POSTGRES_MAX_OPEN_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=30

# SMTP/Mail Configuration
MAIL_ADDRESS=MAIL_ADDRESS
MAIL_DISPLAY_NAME=HoaTheoMua
MAIL_PASSWORD=MAIL_PASSWORD
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# JWT Configuration
JWT_ISSUER=JWT_ISSUER
JWT_AUDIENCE=JWT_AUDIENCE
JWT_ACCESS_TOKEN_KEY=JWT_ACCESS_TOKEN_KEY
JWT_ACCESS_TOKEN_EXPIRE_MIN=15
JWT_REFRESH_TOKEN_KEY=JWT_REFRESH_TOKEN_KEY
JWT_REFRESH_TOKEN_EXPIRE_MIN=1440

# Security Configuration
SECURITY_PEPPER=SECURITY_PEPPER

# Cloudflare Tunnel (public ingress for the API)
CLOUDFLARE_TUNNEL_TOKEN=

# Docker Registry Configuration (for compose.yaml)
REGISTRY=localhost/hoatheomua
TAG=local
