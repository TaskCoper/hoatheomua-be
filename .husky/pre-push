#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

set -e

# Branch name pattern validation
# Allowed patterns: feature/, bugfix/, hotfix/, release/, develop, main, master
current_branch=$(git rev-parse --abbrev-ref HEAD)

# Pattern: feature/, bugfix/, hotfix/, release/ followed by branch name
# Or: develop, main, master
pattern="^(feature|bugfix|hotfix|release)/.+$|^(develop|main|master)$"

if ! echo "$current_branch" | grep -qE "$pattern"; then
  echo "Invalid branch name: $current_branch"
  echo ""
  echo "Branch name must follow one of these patterns:"
  echo "  - feature/your-branch-name"
  echo "  - bugfix/your-branch-name"
  echo "  - hotfix/your-branch-name"
  echo "  - release/your-branch-name"
  echo "  - develop"
  echo "  - main"
  echo "  - master"
  echo ""
  exit 1
fi

echo "Branch name '$current_branch' is valid"

echo "Running pre-push checks..."

echo "[1/3] Restoring solution"
dotnet restore HoaTheoMua.sln --nologo

echo "[2/3] Building solution"
dotnet build HoaTheoMua.sln -c Release --no-restore --nologo

echo "[3/3] Running tests"
dotnet test HoaTheoMua.sln -c Release --no-build --no-restore --nologo

echo "Pre-push checks passed"
