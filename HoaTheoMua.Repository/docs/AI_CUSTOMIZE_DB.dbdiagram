// AI Customize Database Schema
// Project: HTM_Flourist_AI
// Date: 2026-09-09
//
// Flower generation is synchronous. There are no flower_requests or
// flower_ai_jobs tables: request data is passed to the AI module and only a
// successful result is persisted.

Project HTM_Flourist_AI {
  database_type: 'PostgreSQL'
  Note: 'AI Customize schema. Checkout and Order are outside the current scope.'
}

Enum platform_type {
  zalo
  facebook
  instagram
}

Enum system_prompt_types {
  flower
  card
  post
}

Enum form_type {
  go_may
  calligraphy
}

// Prompt hệ thống cho từng loại generation
Table system_prompts {
  id uuid [pk]
  type system_prompt_types [not null, unique]
  content text
}

// Tiêu chuẩn nội dung cho từng nền tảng
Table platform_standards {
  id uuid [pk]
  platform platform_type
  description text
}

// Bảng có sẵn trong Core Database; dùng cho cấu hình thiệp.
Table Config {
  id uuid [pk]
  key varchar
  value jsonb
  is_public boolean
  group varchar
  kind varchar
  user_id uuid
  created_at timestamp
  updated_at timestamp
  is_deleted boolean
  // Card dùng 2 singleton: card_config.sizes và card_config.prices; group/key/kind bất biến.
  // card_config.sizes có đúng một Size chung; client không chọn Size.
}

// Template dùng cho flow AI hoặc mẫu thiệp HandMade do Admin tạo.
Table card_templates {
  id uuid [pk]
  name varchar
  description text
  image_url varchar
  template_type varchar [not null] // ai | handmade; lowercase and immutable
  is_active boolean
  created_at timestamp
  updated_at timestamp
  is_deleted boolean
}

// Bảng products ở Core Database. sellableQuantity là derived value tính bằng
// CalculateAvailableQty từ dữ liệu live; không thêm column sellableQuantity.
Table products {
  id uuid [pk]
  is_active boolean
  is_deleted boolean
}

Table base_posts {
  id uuid [pk]
  content text
  image_url varchar
}

Table generated_posts {
  id uuid [pk]
  content text
  image_url varchar
  user_id uuid
  created_at timestamp
}

// Chỉ lưu kết quả tạo hoa thành công; input_snapshot là snapshot bất biến đã
// validate trước AI, gồm Product/Mockup, bytes hoặc version/hash ảnh và full prompt.
Table generated_flowers {
  id uuid [pk]
  image_url varchar
  user_id uuid
  input_snapshot json
  created_at timestamp
}

Table generated_cards {
  id uuid [pk]
  content text
  image_url varchar // ảnh hoàn chỉnh sau khi AI chèn chữ
  raw_image varchar // nullable cho dữ liệu cũ; ảnh gốc AI sinh trước khi chèn chữ
  user_id uuid
  created_at timestamp
  card_type varchar [not null] // ai | handmade; lowercase

  form_type form_type
  sender_name varchar
  receiver_name varchar
  message_content text
  attached_image_url varchar // null with handmade

  size_name varchar
  size_width decimal
  size_height decimal
  size_base_price decimal
  size_max_words int
  word_count int
  word_config_snapshot json

  base_price decimal
  extra_price decimal
  total_price decimal
}

Table post_histories {
  id uuid [pk]
  input json
  base_id uuid
  output_id uuid
  system_prompt_id uuid
  metadata json
  created_at timestamp
}

// Mockup được quản lý ở Core Database.
Table mockup {
  id uuid [pk]
  name varchar
  description text
  image_url varchar
  is_active boolean
  is_deleted boolean
  created_at timestamp
  updated_at timestamp
}

// Lịch sử kết quả thành công. Không lưu input. metadata là JSON provenance bất biến.
// Với Card, metadata không lặp dữ liệu đã có trong generated_cards: không lưu card_type,
// size value, Calligraphy rule, pricing hoặc image của Template. System Prompt snapshot
// tách sang system_form và chỉ gồm các field của system_prompts ngoại trừ id.
Table client_histories {
  id uuid [pk]
  user_id uuid
  type varchar // flower | card | handmade_card; post currently unused
  system_form json // nullable; {type, content} với AI, null với handmade_card
  metadata json
  created_at timestamp
  root uuid [not null] // products.id gốc; service gán, không có FK
  base_id uuid
  output_id uuid
}

// Config card sử dụng group = "card_config", kind = "Setting".
// key = "card_config.sizes" hoặc "card_config.prices"; value là wrapper JSON cố định,
// trong đó field value là chuỗi JSON chứa items và phải được parse thêm một lớp.
// Với card_config.sizes, items có đúng một phần tử; name chỉ là nhãn snapshot.
// Before enabling NOT NULL, backfill existing card_templates.template_type and
// generated_cards.card_type to "ai". For handmade cards: form_type=calligraphy,
// attached_image_url=null, base_price=0 and total_price=extra_price; size_base_price
// keeps the configured Size price for audit.
// raw_image chỉ áp dụng cho Card AI mới và phải có cùng image_url sau persist;
// Card legacy có raw_image=null không đủ điều kiện làm nguồn TDD-027.
// Backfill root: flower và Card trực tiếp dùng base_id; Card từ Generated Flower
// dùng base_id của Flower History. Không dùng Guid.Empty; record không resolve được
// Product ID gốc phải làm migration thất bại. root không nằm trong public API.

Ref: post_histories.system_prompt_id > system_prompts.id

// Không khai báo Ref cho client_histories.base_id/root/output_id.
// Đây là lineage đa hình do code quản lý, không phải FK.

// Resolve lineage: generated_card -> client_histories(type=card|handmade_card); root luôn
// là products.id gốc. Nếu base_id là generated_flower thì service tìm
// client_histories(type=flower) bằng output_id và lấy base_id của Flower History làm root. Không thêm
// generated_cards.source_flower_id. Soft-delete không xóa history/snapshot;
// HandMade mới bắt buộc provenance đầy đủ và không hỗ trợ Regenerate.
