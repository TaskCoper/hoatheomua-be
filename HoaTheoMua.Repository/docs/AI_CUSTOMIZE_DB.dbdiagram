// AI Customize Database Schema
// Project: HTM_Flourist_AI
// Date: 2026-09-04
//
// Flower generation is synchronous. There are no flower_requests or
// flower_ai_jobs tables: request data is passed to the AI module and only a
// successful result is persisted.

Project HTM_Flourist_AI {
  database_type: 'PostgreSQL'
  Note: 'AI Customize schema. Checkout and Order are outside the current scope.'
}

Enum platform_type {
  zalo
  facebook
  instagram
}

Enum system_prompt_types {
  flower
  card
  post
}

Enum form_type {
  go_may
  calligraphy
}

// Prompt hệ thống cho từng loại generation
Table system_prompts {
  id uuid [pk]
  type system_prompt_types [not null, unique]
  content text
}

// Tiêu chuẩn nội dung cho từng nền tảng
Table platform_standards {
  id uuid [pk]
  platform platform_type
  description text
}

// Bảng có sẵn trong Core Database; dùng cho cấu hình thiệp.
Table Config {
  id uuid [pk]
  key varchar
  value jsonb
  is_public boolean
  group varchar
  kind varchar
  user_id uuid
  created_at timestamp
  updated_at timestamp
  is_deleted boolean
  // Tối đa một record is_public=true, is_deleted=false cho exact (group,key)
}

// Template dùng cho flow AI hoặc mẫu thiệp HandMade do Admin tạo.
Table card_templates {
  id uuid [pk]
  name varchar
  description text
  image_url varchar
  metadata json
  template_type varchar [not null] // ai | handmade; lowercase and immutable
  is_active boolean
  created_at timestamp
  updated_at timestamp
  is_deleted boolean
}

// Bảng products ở Core Database. sellableQuantity là derived value tính bằng
// CalculateAvailableQty từ dữ liệu live; không thêm column sellableQuantity.
Table products {
  id uuid [pk]
  is_active boolean
  is_deleted boolean
}

Table base_posts {
  id uuid [pk]
  content text
  image_url varchar
}

Table generated_posts {
  id uuid [pk]
  content text
  image_url varchar
  user_id uuid
  created_at timestamp
}

// Chỉ lưu kết quả tạo hoa thành công; input_snapshot là snapshot bất biến đã
// validate trước AI, gồm Product/Mockup, bytes hoặc version/hash ảnh và full prompt.
Table generated_flowers {
  id uuid [pk]
  image_url varchar
  user_id uuid
  input_snapshot json
  created_at timestamp
}

Table generated_cards {
  id uuid [pk]
  content text
  image_url varchar
  user_id uuid
  created_at timestamp
  card_type varchar [not null] // ai | handmade; lowercase

  form_type form_type
  size_key varchar
  sender_name varchar
  receiver_name varchar
  message_content text
  attached_image_url varchar // null with handmade

  size_name varchar
  size_width decimal
  size_height decimal
  size_base_price decimal
  size_max_words int
  word_count int
  word_config_snapshot json

  base_price decimal
  extra_price decimal
  total_price decimal
}

Table post_histories {
  id uuid [pk]
  input text
  base_id uuid
  output_id uuid
  system_prompt_id uuid
  metadata json
  created_at timestamp
}

// Mockup được quản lý ở Core Database.
Table mockup {
  id uuid [pk]
  name varchar
  description text
  image_url varchar
  is_active boolean
  is_deleted boolean
  created_at timestamp
  updated_at timestamp
}

// Lịch sử kết quả thành công. metadata là JSON snapshot/provenance bất biến.
// Flower metadata lưu Product/Mockup/prompt/validated_at. AI Card metadata lưu
// source_type, provenance và template/config/prompt. HandMade Card metadata lưu
// provenance + Template/Size/Calligraphy snapshot nhưng không có system prompt.
Table client_histories {
  id uuid [pk]
  user_id uuid
  input text
  type varchar // flower | card | handmade_card | post
  system_prompt_id uuid // nullable; null với handmade_card
  metadata json
  created_at timestamp
  base_id uuid
  output_id uuid
}

// Config card sử dụng: group = "card_size" hoặc "card_config",
// kind = "Setting"; value chứa JSON của size hoặc calligraphy_words.
// Before enabling NOT NULL, backfill existing card_templates.template_type and
// generated_cards.card_type to "ai". For handmade cards: form_type=calligraphy,
// attached_image_url=null, base_price=0 and total_price=extra_price; size_base_price
// keeps the configured Size price for audit.

Ref: post_histories.system_prompt_id > system_prompts.id
Ref: client_histories.system_prompt_id > system_prompts.id

// Polymorphic references in client_histories.
Ref history_base_product: client_histories.base_id > products.id [inactive]
Ref history_base_flower: client_histories.base_id > generated_flowers.id [inactive]
Ref history_output_flower: client_histories.output_id > generated_flowers.id [inactive]
Ref history_output_card: client_histories.output_id > generated_cards.id [inactive]
Ref history_output_post: client_histories.output_id > generated_posts.id [inactive]

// Resolve lineage: generated_card -> client_histories(type=card|handmade_card); nếu base_id là
// generated_flower thì tìm client_histories(type=flower) bằng output_id. Không thêm
// generated_cards.source_flower_id. Soft-delete không xóa history/snapshot;
// HandMade mới bắt buộc provenance đầy đủ và không hỗ trợ Regenerate.
